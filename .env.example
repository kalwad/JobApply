# AI provider key — set here or configure from Settings UI
# Cloud providers (Anthropic/OpenAI/Gemini/OpenRouter) will receive profile and
# form-field context when used for autofill. Prefer Ollama for local-only processing.
JOBAPPLY_ANTHROPIC_API_KEY=

# Optional: AWS credentials for Bedrock provider (or use ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Optional: USAJobs.gov API key for federal job listings (disabled in slim mode)
JOBAPPLY_USAJOBS_API_KEY=

# Data paths
JOBAPPLY_DB_PATH=data/jobapply.db
JOBAPPLY_RESUME_PATH=data/resume.txt

# Server — local-only by default
JOBAPPLY_HOST=127.0.0.1
JOBAPPLY_PORT=8085

# Stage 1 slim mode (disable scrapers/CRM/scheduler). Set false only if you need legacy CareerPulse modules.
JOBAPPLY_SLIM_MODE=true
